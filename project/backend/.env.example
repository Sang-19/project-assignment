# Server
PORT=5000
FRONTEND_URL=https://project-assignment-frontend-tau.vercel.app

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/platform?retryWrites=true&w=majority

# JWT signing secret (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Gmail SMTP (use a Google "App Password", not your real password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Google OAuth 2.0 credentials (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Must exactly match the Authorized redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=https://project-assignment-wyi7.onrender.com/auth/google/callback
